0:["aLeO0W2oopKTTNHCYdNeL",[[["",{"children":["core",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["core",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"style":{"maxWidth":"720px","margin":"0 auto","padding":"4rem 1.5rem"},"children":[["$","section",null,{"children":[["$","h1",null,{"children":"Sensemaking & Pre-Decision Containment"}],["$","p",null,{"children":"This is a quiet, retainer-based engagement for individuals or small groups navigating complex, high-stakes questions where the problem is not lack of intelligence or effort, but collapse of shared meaning."}],["$","p",null,{"children":"I work upstream of decisions, narratives, and strategies — in the space where things are still forming and can still be changed without force."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"What this helps with"}],["$","ul",null,{"children":[["$","li",null,{"children":"Noticing when the framing of a problem is wrong or incomplete"}],["$","li",null,{"children":"Surfacing hidden assumptions before they harden"}],["$","li",null,{"children":"Slowing premature certainty without stalling movement"}],["$","li",null,{"children":"Holding moral, ecological, and strategic ambiguity without panic"}],["$","li",null,{"children":"Protecting fragile ideas until they are ready to take shape"}]]}],["$","p",null,{"children":"My role is not to provide answers, but to keep the thinking space intact long enough for better decisions to become possible."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"What this is not"}],["$","ul",null,{"children":[["$","li",null,{"children":"Consulting with predefined deliverables"}],["$","li",null,{"children":"Facilitation with agendas or outcomes"}],["$","li",null,{"children":"Leadership coaching"}],["$","li",null,{"children":"Content creation"}],["$","li",null,{"children":"Urgency-driven or crisis-response work"}]]}],["$","p",null,{"children":"If you are looking for speed, clarity on demand, or polished conclusions, this will not be a good fit."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"How the engagement works"}],["$","ul",null,{"children":[["$","li",null,{"children":"Retainer-based, month-to-month or fixed-term"}],["$","li",null,{"children":"Typically 2–4 conversations per month"}],["$","li",null,{"children":"Individual or very small group settings"}],["$","li",null,{"children":"Focus on pre-decision moments, not execution or delivery phases"}],["$","li",null,{"children":"No required artifacts, reports, or summaries"}]]}],["$","p",null,{"children":"Written reflections may emerge, but only if they feel necessary. The value is in presence and containment, not output volume."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Pricing & commitment"}],["$","p",null,{"children":"This work is offered on a retainer basis, reflecting that its value lies in availability, continuity, and trust rather than hours or deliverables."}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Individual retainers:"}]," typically"," ",["$","strong",null,{"children":"$$1,500 – $3,000 / month"}]]}],["$","li",null,{"children":[["$","strong",null,{"children":"Small group retainers:"}]," typically"," ",["$","strong",null,{"children":"$$3,000 – $6,000 / month"}]]}]]}],["$","p",null,{"children":"Pricing is discussed openly during an initial conversation and adjusted based on scope, frequency, and depth of involvement."}],["$","p",null,{"children":"I take on very few concurrent engagements to protect the quality of the work. If the terms don’t feel sustainable or aligned on either side, we don’t proceed."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"What success looks like"}],["$","ul",null,{"children":[["$","li",null,{"children":"Fewer irreversible decisions made too early"}],["$","li",null,{"children":"Conversations that become slower, deeper, and more honest"}],["$","li",null,{"children":"Unexamined narratives losing their grip"}],["$","li",null,{"children":"New options quietly appearing"}],["$","li",null,{"children":"Some failures simply never happening"}]]}],["$","p",null,{"children":"Much of this work remains invisible by design."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Next step"}],["$","p",null,{"children":"If this resonates, the next step is a short conversation to see whether the conditions are right on both sides."}],["$","p",null,{"children":"If it doesn’t, that’s completely fine — this work is intentionally narrow."}]]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","core","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/8edf3938794df77d.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en","children":[null,["$","body",null,{"className":"min-h-screen flex flex-col justify-between antialiased","children":[["$","div",null,{"children":[["$","header",null,{"className":"border-b border-slate-800/80 bg-slate-950/40 backdrop-blur-md sticky top-0 z-50 py-5","children":["$","div",null,{"className":"container flex flex-col md:flex-row md:items-center md:justify-between gap-4 py-0","children":[["$","div",null,{"children":[["$","h1",null,{"className":"text-xl font-bold text-slate-50 tracking-tight flex items-center gap-2","children":[["$","span",null,{"className":"w-2.5 h-2.5 bg-indigo-500 rounded-full inline-block"}],"Mentat Commons"]}],["$","p",null,{"className":"text-xs text-slate-400 mt-0.5 font-medium","children":"Designing decisions for collective intelligence"}]]}],["$","nav",null,{"className":"flex flex-wrap gap-y-2","children":[["$","a",null,{"className":"header-lin